static func cevir(kod: String, anahtar: String, degerler: Dictionary = {}) -> String:
	var dil: Dictionary = METINLER.get(kod, METINLER[VARSAYILAN_DIL])
	var metin := str(dil.get(anahtar, METINLER[VARSAYILAN_DIL].get(anahtar, anahtar)))
	for ad in degerler:
		metin = metin.replace("{%s}" % ad, str(degerler[ad]))
	return metin

static func rtl_mi(kod: String) -> bool:
	return kod == "ar"
